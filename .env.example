BOT_TOKEN=your_discord_bot_token_here
MONGODB_URI=mongodb://localhost:27017
LLM_MODEL=vertex_ai/gemini-2.0-flash-exp
LLM_API_KEY=your_gemini_api_key_here
# If using Gemini via LiteLLM, it also looks for GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Enable detailed LiteLLM debugging
LITELLM_DEBUG=False
GITHUB_API_KEY=your_github_pat_here

# Vertex AI Configuration
VERTEX_PROJECT=your-google-cloud-project-id
VERTEX_LOCATION=us-central1
# Path to your Service Account JSON file OR use gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
